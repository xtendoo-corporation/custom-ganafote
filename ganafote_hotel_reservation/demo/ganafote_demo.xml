<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Hotel de ejemplo -->
        <record id="demo_hotel_barcelo" model="res.partner">
            <field name="name">Hotel Barceló Punta Umbría</field>
            <field name="is_company" eval="True"/>
            <field name="supplier_rank">1</field>
            <field name="city">Punta Umbría</field>
        </record>

        <!-- Atributo comercial reutilizando product.attribute estándar -->
        <record id="demo_attr_regimen" model="product.attribute">
            <field name="name">Tipo / Régimen</field>
            <field name="create_variant">always</field>
        </record>
        <record id="demo_attr_val_doble" model="product.attribute.value">
            <field name="name">Doble estándar</field>
            <field name="attribute_id" ref="demo_attr_regimen"/>
        </record>
        <record id="demo_attr_val_doble_mar" model="product.attribute.value">
            <field name="name">Doble vista mar</field>
            <field name="attribute_id" ref="demo_attr_regimen"/>
        </record>
        <record id="demo_attr_val_individual" model="product.attribute.value">
            <field name="name">Individual</field>
            <field name="attribute_id" ref="demo_attr_regimen"/>
        </record>

        <!-- Producto hotelero (pernoctación) -->
        <record id="demo_product_barcelo" model="product.template">
            <field name="name">Pernoctación Hotel Barceló Punta Umbría</field>
            <field name="type">service</field>
            <field name="is_hotel_product" eval="True"/>
            <field name="hotel_id" ref="demo_hotel_barcelo"/>
            <field name="list_price">108.0</field>
        </record>
        <record id="demo_product_barcelo_attr_line" model="product.template.attribute.line">
            <field name="product_tmpl_id" ref="demo_product_barcelo"/>
            <field name="attribute_id" ref="demo_attr_regimen"/>
            <field name="value_ids" eval="[(6, 0, [
                ref('demo_attr_val_doble'),
                ref('demo_attr_val_doble_mar'),
                ref('demo_attr_val_individual'),
            ])]"/>
        </record>

        <!-- Cupo de ejemplo en borrador (el usuario lo confirma para generar disponibilidad) -->
        <record id="demo_allotment_barcelo" model="ganafote.hotel.allotment">
            <field name="hotel_id" ref="demo_hotel_barcelo"/>
            <field name="date_start">2026-08-01</field>
            <field name="date_end">2026-08-08</field>
            <field name="notes">Cupo de ejemplo generado por los datos demo.</field>
        </record>

    </data>
</odoo>
