<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_hotel" model="ir.ui.view">
        <field name="name">product.template.form.hotel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="is_hotel_product"/>
                <field name="hotel_id"
                       invisible="not is_hotel_product"
                       required="is_hotel_product"/>
            </field>
        </field>
    </record>

    <record id="action_product_hotel" model="ir.actions.act_window">
        <field name="name">Productos hoteleros</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_hotel_product', '=', True)]</field>
        <field name="context">{'default_is_hotel_product': True}</field>
    </record>

</odoo>
