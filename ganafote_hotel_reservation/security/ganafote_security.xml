<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="privilege_ganafote_hotel" model="res.groups.privilege">
            <field name="name">Reservas Hoteleras</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
        </record>

        <record id="group_hotel_user" model="res.groups">
            <field name="name">Usuario reservas hoteleras</field>
            <field name="privilege_id" ref="privilege_ganafote_hotel"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_hotel_manager" model="res.groups">
            <field name="name">Responsable reservas hoteleras</field>
            <field name="privilege_id" ref="privilege_ganafote_hotel"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
