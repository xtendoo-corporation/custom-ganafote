<odoo>
        <template
        id="ganafote_document_format.external_layout_bold"
        inherit_id="web.external_layout_bold"
    >
            <xpath
            expr="//div[contains(@t-attf-class, 'header')]/div[hasclass('row')]"
            position="replace"
        >
                <div class="row">
                    <div class="col-6">
                        <img
                        t-if="company.logo"
                        src="/ganafote_document_format/static/src/img/Logo-superior-layout-bold.png"
                        alt="Logo"
                        style="max-height:150px; max-width:300px; margin-bottom:8px;"
                    />
                    </div>
                    <div
                    class="col-5 offset-1"
                    name="company_address"
                    style="line-height: 1.5; margin-top: 8px;"
                >
                        <span
                        t-if="company.company_details"
                        t-field="company.company_details"
                    />
                    </div>

                </div>
                <div
                style="height:2px;width:100%;background-color:black;margin-top:5px;"
            >
                </div>
            </xpath>

            <xpath
            expr="//div[contains(@t-attf-class, 'footer')]/div[hasclass('o_footer_content')]"
            position="replace"
        >
                <div class="col-12">
                    <img
                    style="width:100%;height:200px;margin-top:-25px;"
                    src="/ganafote_document_format/static/src/img/ganafote-footer.png"
                />
                </div>
            </xpath>
        </template>
</odoo>
