<?xml version="1.0" ?>
<odoo>
    <!-- Mail template are declared in a NOUPDATE block
        so users can freely customize/delete them -->
        <!--Email template -->
        <record id="sale_email_template_quotation" model="mail.template">
            <field name="name">Ganafote Presupuestos ropa</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field
            name="email_from"
        >{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field
            name="subject"
        >{{ object.company_id.name }} Pedido/Presupuesto (Ref {{ object.name or 'n/a' }})
            </field>
            <field name="body_html" type="html">
                <div id="header" style="margin-bottom: 150px">
                    <div style="display: flex; justify-content: space-between;">
                        <div id="header_fig" style="width: 50%;">
                            <a href="https://ganafote.com">
                                <img
                                src="https://ganafote16.xtendoo.es/ganafote_document_format/static/src/img/logoymanchasuperior2.png"
                                width="120"
                                style="border-style: none; box-sizing: border-box; display: inline-block; height: auto; width: 300px; max-width: 100%; vertical-align: middle;"
                                class="img-fluid o_we_custom_image"
                            />
                            </a>
                        </div>

                        <div id="header_fig" style="width: 50%;">
                            <p
                            style="text-align: right; margin-right: 20px; font-size: 24px; color: black;"
                        >
                                <t t-if="object.state == 'draft'">Presupuesto Nº</t>
                                <t t-if="object.state != 'draft'">Pedido Nº</t>
                                <t
                                t-out="object.name"
                                data-oe-t-inline="true"
                                contenteditable="false"
                            />
                            </p>
                        </div>
                    </div>
                </div>

                <div
                id="content"
                style="clear:both;width:80%;margin:10px auto;font-size:1.5em;color:black;"
            >
                    <h1>
                        <p style="font-size: 40px">¡HOLA!
                            <span style="color:#83c200; text-transform: uppercase;">
                                <t
                                t-out="object.partner_id.name"
                                data-oe-t-inline="true"
                                contenteditable="false"
                            />
                                ,
                            </span>
                        </p>
                    </h1>
                    <p>
                        Desde el departamento de contabilidad de GAÑAFOTE SLU le hacemos llegar el
                        <span style="color:#83c200">
                            <t t-if="object.state == 'draft'">PRESUPUESTO Nº</t>
                            <t t-if="object.state != 'draft'">PEDIDO Nº</t>
                            <span>
                                <t
                                t-out="object.name"
                                data-oe-t-inline="true"
                                contenteditable="false"
                            />
                            </span>
                        </span>
                        . Quedamos a expensas de confirmación definitiva o respuesta para hacer cualquier modificación
                    </p>
                    <p>
                        Gracias por su atención.
                    </p>

                </div>
                <div id="footer" style="text-align: center;">
                    <a href="https://ganafote.com">
                        <img
                        class="img-fluid o_we_custom_image"
                        src="https://ganafote16.xtendoo.es/ganafote_document_format/static/src/img/footer.png"
                        alt=""
                        style="max-width: 100%; height: auto"
                    />
                    </a>
                </div>
            </field>
            <field
            name="report_template_ids"
            eval="[(6, 0, [ref('sale.action_report_saleorder')])]"
        />
            <field name="lang">${object.partner_id.lang}</field>
            <field name="use_default_to" eval="False" />
            <field name="auto_delete" eval="True" />
        </record>

