<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ganafote.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="standardized_offers_setting" position="after">
                <setting
                    id="company_so_factory_template_setting"
                    string="Factory Default Template"
                    help="Plantilla de presupuesto por defecto para fábrica"
                >
                    <field name="company_so_factory_template_id" />
                </setting>
            </setting>
        </field>
    </record>

    <record id="res_config_settings_view_form_account_move" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ganafote.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="use_invoice_terms" position="after">
                <setting
                    id="confirmation_email_setting"
                    string="Email de entrega"
                    help="Plantilla de correo para notificar entregas"
                >
                    <field
                        name="send_invoice_mail_template_id"
                        options="{'no_create': True}"
                    />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
