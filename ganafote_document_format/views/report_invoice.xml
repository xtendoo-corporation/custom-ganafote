            </xpath>
            <!--            <div class="clearfix mb-4">-->
            <xpath expr="//div[@id='total']" position="replace">
                <div id="total" class="row">
                    <div
                        t-attf-class="#{'col-12' if report_type != 'html' else 'col-sm-8 col-md-7'} ms-auto">
                        <table class="table table-sm table-borderless"
                            style="page-break-inside: avoid; margin: 0px; padding: 0px; width: 100%; table-layout: fixed;">
                            <colgroup>
                                <col style="width: 68%;" />
                                <col style="width: 32%;" />
                            </colgroup>

                            <!--Tax
                            totals-->
                            <t t-if="o.tax_totals" t-call="account.document_tax_totals">
                                <t t-set="tax_totals" t-value="o.tax_totals" />
                                <t t-set="currency" t-value="o.currency_id or o.company_id.currency_id" />
                            </t>

                            <!--Payments-->
                            <t t-if="print_with_payments">
                                <t t-if="o.payment_state != 'invoicing_legacy'">
                                    <t t-set="payments_vals"
                                        t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []" />
                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                        <tr t-if="payment_vals['is_exchange'] == 0">
                                            <td style="margin: 0px; padding: 0px; font-size:12px;">
                                                <i class="oe_form_field text-end oe_payment_label">Pagado
                                                    el <t t-esc="payment_vals['date']"
                                                        t-options='{"widget": "date"}' />
                                                </i>
                                            </td>
                                            <td class="text-end"
                                                style="margin: 0px; padding: 0px; font-size:12px;">
                                                <span t-esc="payment_vals['amount']"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="len(payments_vals) > 0">
                                        <tr class="border-black">
                                            <td style="margin: 0px; padding: 0px; font-size:12px; white-space: nowrap;">Importe adeudado</td>
                                            <td class="text-end"
                                                style="margin: 0px; padding: 0px; font-size:12px;">
                                                <span t-field="o.amount_residual" />
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </table>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='total']" position="after">
                <table style="width:100%;border-color:white; margin-top: 20px;">
                    <tr>
                        <td>
                            <div style="text-align: center;">
                                <t t-if="o.company_id.id == 1">
                                    <p style="border: 2px solid #C3C7C9; border-radius:20px; display:block;text-align:center; padding:15px 20px; margin-top:5px;font-size:13px; white-space: normal; width: fit-content; margin-left: auto; margin-right: auto;">
                                        <img src="/ganafote_document_format/static/src/img/crsur.png" alt="Caja Rural" style="height: 13px; margin-right: 6px; vertical-align: middle;" />
                                        IBAN ES65 3187 0022 6266 8329 0925
                                        <br/>
                                        <img src="/ganafote_document_format/static/src/img/santander.png" alt="Santander" style="height: 13px; margin-right: 6px; vertical-align: middle;" />
                                        IBAN ES74 0049 0012 7123 1219 3764
                                    </p>
                                </t>
                                <t t-if="o.company_id.id != 1">
                                    <p style="border: 2px solid #222036; border-radius:20px; display:inline-block;text-align:center; padding:10px 20px; margin-top:5px;font-size:13px;white-space:nowrap;">CUENTA GAÑAFOTE SPORTS EVENTS = IBAN ES61 3187 0022 6966 8329 1527
                                    </p>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>
            </xpath>
        </field>
    </record>

    <record id="custom_document_tax_totals" model="ir.ui.view">
        <field name="name">custom.document.tax.totals</field>
        <field name="inherit_id" ref="account.document_tax_totals" />
        <field name="arch" type="xml">
            <xpath expr="//tr[hasclass('o_subtotal')]" position="replace">
                <tr t-if="subtotal['tax_groups']" class="o_subtotal">
                    <td style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong t-out="subtotal['name']" />
                    </td>

                    <td class="text-end" style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong>
                            <span
                                t-att-class="oe_subtotal_footer_separator"
                                t-out="subtotal['base_amount_currency']"
                                t-options="{'widget': 'monetary', 'display_currency': currency or env.company.currency_id}"
                            />
                        </strong>
                    </td>
                </tr>
            </xpath>
            <xpath expr="//tr[hasclass('o_total')]" position="replace">
                <tr class="o_total">
                    <td style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong>Total</strong>
                    </td>
                    <td class="text-end" style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong
                            t-out="tax_totals['total_amount_currency']"
                            t-options="{'widget': 'monetary', 'display_currency': currency or env.company.currency_id}"
                        />
                    </td>
                </tr>
            </xpath>
        </field>
    </record>
</odoo>
