<odoo>

    <record id="ganafote_report_invoice_document" model="ir.ui.view">
        <field name="name">ganafote.report.invoice.document</field>
        <field name="inherit_id" ref="account.report_invoice_document" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-set='layout_document_title']" position="replace">

                <t t-set="company_color"
                    t-value="{1: '#C3C7C9', 2: '#222036', 3: '#aeef9a', 4: '#bf954b'}.get(o.company_id.id, '#222036')" />
                <t t-set="colorbackground"
                    t-value="'color:#ffffff; background-color:%s; display:inline-block;border-radius: 20px; padding: 5px 10px;' % company_color" />

                <t t-set="layout_document_title">
                    <span t-att-style="colorbackground">
                        <span
                            t-if="o.move_type == 'out_invoice' and o.state == 'posted'"
                        >FACTURA
                        </span>
                        <span
                            t-if="o.move_type == 'out_invoice' and o.state == 'draft'"
                        >FACTURA
                            BORRADOR
                        </span>
                        <span
                            t-if="o.move_type == 'out_invoice' and o.state == 'cancel'"
                        >FACTURA
                            CANCELADA
                        </span>
                        <span
                            t-if="o.move_type == 'out_refund'"
                        >FACTURA RECTIFICATIVA
                        </span>
                        <span
                            t-if="o.move_type == 'in_refund'"
                        >FACTURA RECTIFICATIVA DE PROVEEDOR
                        </span>
                        <span
                            t-if="o.move_type == 'in_invoice'"
                        >FACTURA DE PROVEEDOR
                        </span>
                        <span
                            t-if="o.name != '/'"
                            t-field="o.name"
                        />
                    </span>
                </t>
            </xpath>
            <xpath expr="//div[@name='origin']" position="replace" />
            <xpath expr="//div[@name='reference']" position="replace" />
            <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping'] | //div[@id='partner_vat_address_same_as_shipping'] | //div[@id='partner_vat_no_shipping']" position="attributes">
                <attribute name="style">margin-top:-0.75em;</attribute>
            </xpath>
            <xpath expr="//table[hasclass('o_main_table')]/thead" position="replace">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" style="text-align:left;font-weight:bold;">Descripción</th>
                        <th name="th_quantity" style="text-align:right;font-weight:bold;">Cantidad</th>
                        <th name="th_priceunit" style="text-align:right;font-weight:bold;">Precio/U</th>
                        <th
                            name="th_discount"
                            t-if="display_discount"
                            class="text-right"
                            style="font-weight:bold;"
                            groups="product.group_discount_per_so_line"
                        >
                            <span>Desc.%</span>
                        </th>
                        <th name="th_subtotal" style="text-align:right;font-weight:bold;">
                            <span>Total</span>
                        </th>
                    </tr>
                </thead>
            </xpath>
            <xpath expr="//table[hasclass('o_main_table')]/tbody" position="replace">
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0" />
                    <t
                        t-set="lines"
                        t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"
                    />

                    <t t-foreach="lines" t-as="line">
                        <t
                            t-set="current_subtotal"
                            t-value="current_subtotal + line.price_subtotal"
                            groups="account.group_show_line_subtotals_tax_excluded"
                        />
                        <t
                            t-set="current_subtotal"
                            t-value="current_subtotal + line.price_total"
                            groups="account.group_show_line_subtotals_tax_included"
                        />

                        <tr
                            t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''"
                        >
                            <t
                                t-if="line.display_type == 'product'"
                                name="account_invoice_line_accountable"
                            >
                                <td name="account_invoice_line_name"
                                    style="padding-top:4px;padding-bottom:4px;line-height:1.3;">
                                    <span
                                        t-field="line.name"
                                        t-options="{'widget': 'text'}"
                                    />
                                </td>
                                <td style="text-align:right;padding-top:4px;padding-bottom:4px;line-height:1.3;">
                                    <span t-field="line.quantity" />
                                    <span
                                        t-field="line.product_uom_id"
                                        groups="uom.group_uom"
                                    />
                                </td>
                                <td style="text-align:right;padding-top:4px;padding-bottom:4px;line-height:1.3;"
                                    t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                >
                                    <span
                                        class="text-nowrap"
                                        t-field="line.price_unit"
                                    />
                                </td>
                                <td style="text-align:right;padding-top:4px;padding-bottom:4px;line-height:1.3;"
                                    t-if="display_discount"
                                    t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                >
                                    <span
                                        class="text-nowrap"
                                        t-field="line.discount"
                                    />
                                </td>
                                <!--  <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if
                                report_type == 'html' else '' }}">
                                      <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                  </td> -->
                                <td class="o_price_total"
                                    style="text-align:right;padding-top:4px;padding-bottom:4px;line-height:1.3;">
                                    <span
                                        class="text-nowrap"
                                        t-field="line.price_subtotal"
                                    />
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99" style="margin: 2px; padding: 2px;">
                                    <span
                                        t-field="line.name"
                                        t-options="{'widget': 'text'}"
                                    />
                                </td>
                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subtotal" t-value="0" />
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" style="margin: 2px; padding: 2px;">
                                    <span
                                        t-field="line.name"
                                        t-options="{'widget': 'text'}"
                                    />
                                </td>
                            </t>
                        </tr>

                        <t
                            t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')"
                        >
                            <tr class="is-subtotal text-right">
                                <td colspan="99" style="margin: 2px; padding: 2px;">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                        t-esc="current_subtotal"
                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"
                                    />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </xpath>
            <xpath expr="//p[@name='payment_communication']" position="attributes">
                <attribute name="style">margin-top: 5px;</attribute>
            </xpath>
            <xpath expr="//span[@name='payment_term']" position="after">

            </xpath>
            <xpath expr="//div[@id='right-elements']" position="attributes">
                <attribute name="t-attf-class">#{'col-5' if report_type == 'pdf' else 'col-12 col-md-5'} ms-5 d-inline-block float-end</attribute>
                <attribute name="style">margin-top:0 !important;</attribute>
            </xpath>
            <xpath expr="//div[@id='total']" position="before">
                <style>
                    #total table td, #total table th {
                        padding-top: 2px !important;
                        padding-bottom: 2px !important;
                        line-height: 1.25 !important;
                    }
                </style>
            </xpath>
            <xpath expr="//div[@id='right-elements']" position="after">
                <div style="clear:both; width:100%; text-align:center; page-break-inside:avoid;">
                    <table style="width:100%; border-color:white; margin-top:20px;">
                        <tr>
                            <td>
                                <div style="text-align: center;">
                                    <t t-if="o.company_id.id == 1">
                                        <p style="border: 2px solid #C3C7C9; border-radius:20px; display:block;text-align:center; padding:15px 20px; margin-top:5px;font-size:13px; white-space: normal; width: fit-content; margin-left: auto; margin-right: auto;">
                                            <img src="/ganafote_document_format/static/src/img/crsur.png" alt="Caja Rural" style="height: 13px; margin-right: 6px; vertical-align: middle;" />
                                            IBAN ES65 3187 0022 6266 8329 0925
                                            <br/>
                                            <img src="/ganafote_document_format/static/src/img/santander.png" alt="Santander" style="height: 13px; margin-right: 6px; vertical-align: middle;" />
                                            IBAN ES74 0049 0012 7123 1219 3764
                                        </p>
                                    </t>
                                    <t t-if="o.company_id.id != 1">
                                        <p style="border: 2px solid #C3C7C9; border-radius:20px; display:block;text-align:center; padding:15px 20px; margin-top:5px;font-size:13px; white-space: normal; width: fit-content; margin-left: auto; margin-right: auto;">
                                            <img src="/ganafote_document_format/static/src/img/crsur.png" alt="Caja Rural" style="height: 13px; margin-right: 6px; vertical-align: middle;" />
                                            IBAN ES61 1318 0022 6966 8329 1527
                                        </p>
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <div style="width:100%; font-size:11px; margin-top:15px; text-align:left; page-break-inside:avoid;">
                        <div>
                            <p style="background-color:#C3C7C9;width:50%;display:block;border-radius: 20px;padding: 10px 20px;font-weight:bolder;">
                                Información sobre protección de datos
                            </p>
                        </div>
                        Como responsable del tratamiento le informamos que recabamos sus datos con la
                        finalidad de prestarles el servicio solicitado y emitir la correspondiente
                        factura del mismo. La base legal para el tratamiento de sus datos es la
                        ejecución del servicio contratado y la obligación legal de expedir la factura
                        del mismo. Conservaremos sus datos el tiempo estrictamente necesario para
                        responder a exigencias legales. Los datos no se cederán a terceros salvo en los
                        casos en que exista una obligación legal. Puede ejercer sus derechos de acceso,
                        rectificación, supresión y portabilidad de sus datos, y la limitación u
                        oposición a su tratamiento a través de nuestro correo electrónico o domicilio
                        fiscal. De igual modo, podría interponer una reclamación ante la Autoridad de
                        Control en www.aepd.es.
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="custom_document_tax_totals" model="ir.ui.view">
        <field name="name">custom.document.tax.totals</field>
        <field name="inherit_id" ref="account.document_tax_totals" />
        <field name="arch" type="xml">
            <xpath expr="//tr[hasclass('o_subtotal')]" position="replace">
                <tr t-if="subtotal['tax_groups']" class="o_subtotal">
                    <td style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong t-out="subtotal['name']" />
                    </td>

                    <td class="text-end" style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong>
                            <span
                                t-att-class="oe_subtotal_footer_separator"
                                t-out="subtotal['base_amount_currency']"
                                t-options="{'widget': 'monetary', 'display_currency': currency or env.company.currency_id}"
                            />
                        </strong>
                    </td>
                </tr>
            </xpath>
            <xpath expr="//tr[hasclass('o_total')]" position="replace">
                <tr class="o_total">
                    <td style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong>Total</strong>
                    </td>
                    <td class="text-end" style="margin: 0px; padding: 0px; font-size:20px; white-space: nowrap;">
                        <strong
                            t-out="tax_totals['total_amount_currency']"
                            t-options="{'widget': 'monetary', 'display_currency': currency or env.company.currency_id}"
                        />
                    </td>
                </tr>
            </xpath>
        </field>
    </record>
</odoo>
